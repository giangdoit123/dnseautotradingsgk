{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:endpoint*",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/python/ui/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/python/ui/index.html"
    }
  ]
}
