{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:endpoint*",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/python/ui/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/python/ui/index.html"
    }
  ]
}
