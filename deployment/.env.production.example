# Copy this file to deployment/.env.production. Never commit the copied file.
# Use a UAT pair first; switch every DNSE URL and credential together for live.

DNSE_API_KEY=replace-with-your-api-key
DNSE_API_SECRET=replace-with-your-api-secret
DNSE_API_VERSION=2026-07-23

# Production DNSE endpoints
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn

# Needed only when launching the automated trader container separately.
DNSE_ACCOUNT_NO=
SYMBOL=
OHLC_SYMBOL=VN30F1M
MARKET_TYPE=DERIVATIVE
RESOLUTION=1
STRATEGY=ichimoku_volume_mtf
ENTRY_MODE=intrabar
QUANTITY=1
PLACE_ORDER=0
